<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (NotifyIcon); WPF has no equivalent. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClaudeUsageMonitor</AssemblyName>
    <RootNamespace>ClaudeUsageMonitor</RootNamespace>
    <Version>0.4.2</Version>
    <!-- Exe icon for File Explorer, the taskbar and shortcuts. Source art is in ..\resources. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Claude Usage Monitor</Product>
    <Authors>Akbar Goldoust</Authors>
    <Copyright>Copyright (c) 2026 Akbar Goldoust</Copyright>
    <Description>Shows Claude plan limits live from claude.ai and Claude Code token usage from local logs, in a dashboard and an always-on-top widget.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/agoldust/Claude-Monitor-Usage-Statics</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep Windows Forms out of the global usings, so Application, Button, Color and the like stay WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Author photo for the About window (the author's public GitHub avatar). -->
    <Resource Include="Assets\author.jpg" />
    <!-- Window icons and the in-app logo. -->
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read by AppInfo for the About window. -->
    <AssemblyMetadata Include="BuildDateUtc" Value="$([System.DateTime]::UtcNow.ToString('o'))" />
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
  </ItemGroup>

</Project>
