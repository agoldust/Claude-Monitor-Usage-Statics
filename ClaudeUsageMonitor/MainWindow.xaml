<Window x:Class="ClaudeUsageMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ClaudeUsageMonitor.Controls"
        Title="Claude Usage Monitor"
        Width="1100" Height="860" MinWidth="360" MinHeight="400" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        Icon="pack://application:,,,/Assets/app.ico"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">

    <!-- Borderless glass window: the header row is the drag area, and the edges still resize. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- One vertical bar in a column chart. Row heights come from the item's star values. -->
        <DataTemplate x:Key="ColumnBarTemplate">
            <Grid Margin="2,0" Background="Transparent" ToolTip="{Binding Tooltip}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding Empty}" />
                    <RowDefinition Height="{Binding Filled}" />
                    <RowDefinition Height="18" />
                </Grid.RowDefinitions>
                <Border Grid.Row="1" Background="{Binding Brush}" CornerRadius="3,3,0,0" />
                <TextBlock Grid.Row="2" Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center"
                           VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </DataTemplate>

        <!-- Icon in front of a top-bar button label (Segoe MDL2 Assets, built into Windows 10 and 11). -->
        <Style x:Key="ButtonGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <ItemsPanelTemplate x:Key="OneRowPanel">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Border x:Name="Root" Background="#CC1C1B19" BorderBrush="#40FFFFFF" BorderThickness="1">
    <DockPanel x:Name="Shell" Margin="16,10,10,16">

        <!-- Top bar: window buttons, actions, and title. Empty space here drags the window.
             The buttons come first so they always get their space; the title takes what is left and trims.
             On narrow windows the actions move to a second row (see ApplyTopBarLayout). -->
        <DockPanel x:Name="TopBar" DockPanel.Dock="Top" Margin="0,0,6,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Minimize"
                        AutomationProperties.Name="Minimize" Click="Minimize_Click" />
                <Button x:Name="MaximizeButton" Style="{StaticResource IconButton}" Content="&#xE922;" ToolTip="Maximize"
                        AutomationProperties.Name="Maximize" Click="Maximize_Click" />
                <Button Style="{StaticResource CloseIconButton}" Content="&#xE8BB;" ToolTip="Close"
                        AutomationProperties.Name="Close" Click="CloseWindow_Click" />
            </StackPanel>
            <StackPanel x:Name="ActionBar" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Less-used actions are icon-only, so the bar stays short. Tooltips name them. -->
                <Button x:Name="WidgetButton" Padding="10,6" Margin="0,0,6,0" Click="WidgetButton_Click"
                        ToolTip="Show widget" AutomationProperties.Name="Show widget">
                    <TextBlock Style="{StaticResource ButtonGlyph}" Margin="0" Text="&#xE718;" />
                </Button>
                <Button Padding="10,6" Margin="0,0,6,0" Click="SettingsButton_Click" ToolTip="Settings"
                        AutomationProperties.Name="Settings">
                    <TextBlock Style="{StaticResource ButtonGlyph}" Margin="0" Text="&#xE713;" />
                </Button>
                <Button Padding="10,6" Margin="0,0,12,0" Click="AboutButton_Click" ToolTip="About"
                        AutomationProperties.Name="About">
                    <TextBlock Style="{StaticResource ButtonGlyph}" Margin="0" Text="&#xE946;" />
                </Button>
                <Button x:Name="SignInButton" Padding="12,6" Margin="0,0,8,0" Click="SignInButton_Click"
                        AutomationProperties.Name="{Binding Text, ElementName=SignInButtonText}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SignInGlyph" Style="{StaticResource ButtonGlyph}" Text="&#xE77B;" />
                        <TextBlock x:Name="SignInButtonText" Text="Sign in" />
                    </StackPanel>
                </Button>
                <!-- The answer to "is this data fresh?" sits next to the button that refreshes it. -->
                <TextBlock x:Name="LastRefreshText" VerticalAlignment="Center" Margin="0,0,8,0" TextAlignment="Right" />
                <Button x:Name="RefreshButton" Padding="12,6" Click="RefreshButton_Click" ToolTip="Refresh now (F5)"
                        AutomationProperties.Name="Refresh">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RefreshGlyph" Style="{StaticResource ButtonGlyph}" Text="&#xE72C;" />
                        <AccessText x:Name="RefreshLabel" Text="_Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <!-- A Grid, not a horizontal StackPanel, so the title gets a finite width and can trim. -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="AppLogo" Source="pack://application:,,,/Assets/app-logo.png" Width="42" Height="42" Margin="0,0,12,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="Claude Usage Monitor logo" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Claude Usage Monitor" FontSize="22" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <!-- Trimmed when the window is narrow; the tooltip shows the whole line. -->
                    <TextBlock x:Name="StatusText" Style="{StaticResource LabelStyle}" Text="Loading..."
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto">
            <!-- Sections are placed in code (ApplyLayout): one column on normal screens, two side by side on wide ones.
                 MaxWidth keeps lines readable on very large monitors; the grid is centered past it.
                 Every card has a 12 px right margin as the gap to its neighbour; the -12 right margin moves the last
                 card's gap out of view, so the left and right edges have the same spacing. -->
            <Grid x:Name="DashboardGrid" MaxWidth="3600" Margin="0,0,-12,0">
                <!-- The third column is used only in the extra-wide layout; ApplyLayout sets its width to 0 otherwise. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="ThirdColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Live limits from claude.ai -->
                <Border x:Name="LiveCard" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <!-- Status sits under the heading, so a long message wraps across the full width. -->
                        <TextBlock Text="Live plan limits" Style="{StaticResource HeadingStyle}" Margin="0,0,0,2" />
                        <TextBlock x:Name="LiveStatusText" Style="{StaticResource LabelStyle}" TextWrapping="Wrap"
                                   Margin="0,0,0,10" Text="Checking claude.ai..." />
                        <!-- Ticking countdown to when tokens are available again; red while a limit is used up. -->
                        <TextBlock x:Name="AvailabilityText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Margin="0,0,0,10" Visibility="Collapsed" />

                        <!-- Same trick as DashboardGrid: -12 hides the last tile's right gap. -->
                        <ItemsControl x:Name="LimitsList" AutomationProperties.Name="Live plan limits" Margin="0,0,-12,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- The width comes from LimitsList.Tag, set in code so the tiles fill each row. -->
                                    <Border Width="{Binding Tag, ElementName=LimitsList}" Margin="0,0,12,12" Padding="14" CornerRadius="8"
                                            Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                                            <DockPanel>
                                                <c:RingGauge DockPanel.Dock="Left" Width="112" Height="112" Margin="0,0,14,0"
                                                             Value="{Binding Percent}" InnerValue="{Binding ElapsedPercent}"
                                                             ValueBrush="{Binding RingBrush}" TrackBrush="#33FFFFFF"
                                                             InnerBrush="#CCFFFFFF" TextBrush="White"
                                                             AutomationProperties.Name="{Binding UsageText}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding UsageText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Reset.Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding PaceText}" Style="{StaticResource LabelStyle}"
                                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource LabelStyle}"
                                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="LiveExtraText" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock x:Name="LiveLegendText" Style="{StaticResource LabelStyle}" TextWrapping="Wrap"
                                   Text="Outer ring: how much of the limit is used. Inner ring: how much of the limit's time window has passed. When the outer ring runs ahead of the inner ring, you are using the limit faster than it resets." />
                    </StackPanel>
                </Border>

                <!-- Totals. Today is the accent card; the token split per type is in each card's tooltip. -->
                <UniformGrid x:Name="TotalsGrid" Columns="4">
                    <Border x:Name="TodayCard" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource AccentBrush}">
                        <StackPanel>
                            <TextBlock Text="Today" Style="{StaticResource LabelStyle}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                            <TextBlock x:Name="TodayTokensText" Style="{StaticResource BigNumberStyle}" />
                            <TextBlock x:Name="TodayDetailText" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="WeekCard" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Last 7 days" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="WeekTokensText" Style="{StaticResource BigNumberStyle}" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="WeekDetailText" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="MonthCard" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Last 30 days" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="MonthTokensText" Style="{StaticResource BigNumberStyle}" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="MonthDetailText" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="AllCard" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="All time" Style="{StaticResource LabelStyle}" />
                            <TextBlock x:Name="AllTokensText" Style="{StaticResource BigNumberStyle}" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="AllDetailText" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Daily chart -->
                <Border x:Name="DailyCard" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel>
                            <!-- On small screens the note goes under the heading (ApplyLayout docks the heading to the top). -->
                            <TextBlock x:Name="DailyChartHeading" Text="Tokens per day, last 14 days" Style="{StaticResource HeadingStyle}" />
                            <TextBlock x:Name="DailyChartNote" Style="{StaticResource LabelStyle}" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,0,8" />
                        </DockPanel>
                        <ItemsControl x:Name="DailyChart" Height="190" ItemsPanel="{StaticResource OneRowPanel}"
                                      ItemTemplate="{StaticResource ColumnBarTemplate}"
                                      AutomationProperties.Name="Tokens per day chart" />
                    </StackPanel>
                </Border>

                <!-- Model share and token mix -->
                <Border x:Name="ModelCard" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Tokens by model, all time" Style="{StaticResource HeadingStyle}" />
                        <!-- Label and value columns size to their content and stay aligned across rows, so the bar keeps the rest. -->
                        <ItemsControl x:Name="ModelShareList" AutomationProperties.Name="Tokens by model"
                                      Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5" Background="Transparent" ToolTip="{Binding Tooltip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ModelLabel" />
                                            <ColumnDefinition Width="*" MinWidth="40" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ModelValue" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="140" Margin="0,0,10,0" />
                                        <Grid Grid.Column="1" Margin="0,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding Filled}" />
                                                <ColumnDefinition Width="{Binding Empty}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Height="16" CornerRadius="3" Background="{Binding Brush}" />
                                        </Grid>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" TextAlignment="Right"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="MixCard" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Token mix, last 30 days" Style="{StaticResource HeadingStyle}" />
                        <Border CornerRadius="4" ClipToBounds="True" Margin="0,4,0,10">
                            <Grid x:Name="TokenMixBar" Height="24" AutomationProperties.Name="Token mix bar" />
                        </Border>
                        <ItemsControl x:Name="TokenMixLegend">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{Binding Brush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Text}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Hour of day -->
                <Border x:Name="HourCard" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="When you use Claude: tokens by hour of day, last 30 days" Style="{StaticResource HeadingStyle}" />
                        <ItemsControl x:Name="HourChart" Height="150" ItemsPanel="{StaticResource OneRowPanel}"
                                      ItemTemplate="{StaticResource ColumnBarTemplate}"
                                      AutomationProperties.Name="Tokens by hour of day chart" />
                    </StackPanel>
                </Border>

                <!-- Account (collapsed) -->
                <Border x:Name="AccountCard" Style="{StaticResource CardStyle}">
                    <Expander x:Name="AccountExpander" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock x:Name="AccountHeaderText" Text="Account" FontSize="15" FontWeight="SemiBold" />
                        </Expander.Header>
                        <UniformGrid x:Name="AccountGrid" Columns="2" Margin="0,10,0,0">
                            <TextBlock x:Name="EmailText" Margin="0,0,0,6" />
                            <TextBlock x:Name="NameText" Margin="0,0,0,6" />
                            <TextBlock x:Name="PlanText" Margin="0,0,0,6" />
                            <TextBlock x:Name="BillingText" Margin="0,0,0,6" />
                            <TextBlock x:Name="OrgText" Margin="0,0,0,6" />
                            <TextBlock x:Name="RoleText" Margin="0,0,0,6" />
                            <TextBlock x:Name="RateTierText" Margin="0,0,0,6" />
                            <TextBlock x:Name="ExtraUsageText" Margin="0,0,0,6" />
                            <TextBlock x:Name="AccountCreatedText" Margin="0,0,0,6" />
                            <TextBlock x:Name="SubscriptionCreatedText" Margin="0,0,0,6" />
                            <TextBlock x:Name="CredentialsExpireText" Margin="0,0,0,6" />
                        </UniformGrid>
                    </Expander>
                </Border>

                <!-- Detailed tables (collapsed) -->
                <Border x:Name="TablesCard" Style="{StaticResource CardStyle}">
                    <Expander IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Text="Detailed tables" FontSize="15" FontWeight="SemiBold" />
                        </Expander.Header>
                        <!-- Stacked on normal screens, three side by side on wide ones (see ApplyLayout). -->
                        <Grid x:Name="TablesGrid" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="DailyTable">
                                <TextBlock Text="Last 14 days" Style="{StaticResource HeadingStyle}" />
                                <DataGrid x:Name="DailyGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" Background="Transparent" Margin="0,0,0,16"
                                          AutomationProperties.Name="Daily usage table">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Day" Binding="{Binding Day, StringFormat=\{0:ddd dd MMM\}}" Width="*" />
                                        <DataGridTextColumn Header="Requests" Binding="{Binding Requests, StringFormat=N0}" Width="Auto" />
                                        <DataGridTextColumn Header="Tokens" Binding="{Binding Tokens, StringFormat=N0}" Width="*" />
                                        <DataGridTextColumn Header="Est. cost" Binding="{Binding Cost, StringFormat=\${0:F2}}" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>

                            <StackPanel x:Name="ModelTable">
                                <TextBlock Text="By model, all time" Style="{StaticResource HeadingStyle}" />
                                <DataGrid x:Name="ModelGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" Background="Transparent" Margin="0,0,0,16"
                                          AutomationProperties.Name="Usage by model table">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*" />
                                        <DataGridTextColumn Header="Requests" Binding="{Binding Requests, StringFormat=N0}" Width="Auto" />
                                        <DataGridTextColumn Header="Tokens" Binding="{Binding Tokens, StringFormat=N0}" Width="*" />
                                        <DataGridTextColumn Header="Est. cost" Binding="{Binding Cost, StringFormat=\${0:F2}}" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>

                            <StackPanel x:Name="ProjectTable">
                                <TextBlock Text="Top projects, all time" Style="{StaticResource HeadingStyle}" />
                                <DataGrid x:Name="ProjectGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" Background="Transparent"
                                          AutomationProperties.Name="Usage by project table">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Project folder" Binding="{Binding ProjectFolder}" Width="2*" />
                                        <DataGridTextColumn Header="Sessions" Binding="{Binding SessionCount}" Width="Auto" />
                                        <DataGridTextColumn Header="Tokens" Binding="{Binding Tokens, StringFormat=N0}" Width="*" />
                                        <DataGridTextColumn Header="Est. cost" Binding="{Binding Cost, StringFormat=\${0:F2}}" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </Border>

                <TextBlock x:Name="FooterText" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" Margin="0,0,12,0"
                           Text="Token charts and costs come from local Claude Code logs, so they cover Claude Code only. Costs are estimates from list prices (see docs/USAGE_DATA.md). Live limits come from claude.ai and cover all your Claude use." />
            </Grid>
        </ScrollViewer>
    </DockPanel>
    </Border>
</Window>
