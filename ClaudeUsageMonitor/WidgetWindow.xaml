<Window x:Class="ClaudeUsageMonitor.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ClaudeUsageMonitor.Controls"
        Title="Claude Usage Widget"
        Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        FontFamily="Segoe UI" Foreground="White">

    <Window.Resources>
        <!-- Small flat icon button for the dark glass. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A button that looks like plain text, so clicks are not taken by window dragging. -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="12" Padding="14,10,14,12" BorderBrush="#40FFFFFF" BorderThickness="1"
            Background="#4D1C1B19" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Refresh now" Click="Refresh_Click" />
                <MenuItem Header="Open dashboard" Click="Dashboard_Click" />
                <MenuItem Header="Settings..." Click="Settings_Click" />
                <MenuItem x:Name="TopmostMenuItem" Header="Always on top" IsCheckable="True" Click="TopmostMenuItem_Click" />
                <MenuItem Header="About..." Click="About_Click" />
                <Separator />
                <MenuItem Header="Close widget" Click="Close_Click" />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel>
            <StackPanel.Effect>
                <!-- Keeps white text readable over bright windows behind the glass. -->
                <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="0.75" />
            </StackPanel.Effect>

            <!-- Header -->
            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh now"
                            AutomationProperties.Name="Refresh now" Click="Refresh_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings"
                            AutomationProperties.Name="Settings" Click="Settings_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Open dashboard"
                            AutomationProperties.Name="Open dashboard" Click="Dashboard_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close widget"
                            AutomationProperties.Name="Close widget" Click="Close_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app-logo.png" Width="18" Height="18" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Claude usage" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <!-- Live limit gauges -->
            <ItemsControl x:Name="GaugeList" AutomationProperties.Name="Live plan limits">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,0,4,8" HorizontalAlignment="Center"
                                    ToolTip="{Binding PaceText}">
                            <c:RingGauge Width="92" Height="92" Thickness="9"
                                         Value="{Binding Percent}" InnerValue="{Binding ElapsedPercent}"
                                         ValueBrush="{Binding RingBrush}" TrackBrush="#40FFFFFF"
                                         InnerBrush="#CCFFFFFF" TextBrush="White"
                                         AutomationProperties.Name="{Binding UsageText}" />
                            <TextBlock Text="{Binding ShortLabel}" HorizontalAlignment="Center"
                                       FontWeight="SemiBold" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding ResetShort}" HorizontalAlignment="Center"
                                       FontSize="11" Opacity="0.85" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="LiveButton" Style="{StaticResource TextButton}" Margin="0,0,0,8" Click="LiveButton_Click">
                <TextBlock x:Name="LiveText" TextWrapping="Wrap" FontSize="12" MaxWidth="270" />
            </Button>

            <!-- Today -->
            <DockPanel Margin="0,2,0,4">
                <TextBlock x:Name="TodayDetailText" DockPanel.Dock="Right" VerticalAlignment="Bottom"
                           FontSize="11" Opacity="0.85" />
                <TextBlock VerticalAlignment="Bottom">
                    <Run x:Name="TodayTokensRun" FontSize="18" FontWeight="SemiBold" Text="-" />
                    <Run Text=" tokens today" FontSize="11" />
                </TextBlock>
            </DockPanel>

            <!-- 14-day mini chart -->
            <ItemsControl x:Name="MiniChart" Height="40" AutomationProperties.Name="Tokens per day, last 14 days">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="1,0" Background="Transparent" ToolTip="{Binding Tooltip}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{Binding Empty}" />
                                <RowDefinition Height="{Binding Filled}" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="1" Background="{Binding Brush}" CornerRadius="2,2,0,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="UpdatedText" FontSize="10" Opacity="0.75" Margin="0,6,0,0" />
        </StackPanel>
    </Border>
</Window>
