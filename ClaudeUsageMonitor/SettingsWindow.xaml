<Window x:Class="ClaudeUsageMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#FBFAF7" FontFamily="Segoe UI">
    <StackPanel Margin="20">

        <TextBlock Text="Refresh" Style="{StaticResource HeadingStyle}" />
        <DockPanel Margin="0,0,0,4">
            <ComboBox x:Name="RefreshCombo" DockPanel.Dock="Right" Width="150"
                      SelectionChanged="RefreshCombo_SelectionChanged" AutomationProperties.Name="Refresh interval" />
            <TextBlock Text="Refresh data every" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Style="{StaticResource LabelStyle}" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Applies to the dashboard and the widget. The shortest interval is 30 seconds, so claude.ai is not asked too often." />

        <TextBlock Text="Widget" Style="{StaticResource HeadingStyle}" />
        <DockPanel>
            <TextBlock x:Name="OpacityValueText" DockPanel.Dock="Right" />
            <TextBlock Text="Background opacity" />
        </DockPanel>
        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                Margin="0,4,0,4" ValueChanged="OpacitySlider_ValueChanged" AutomationProperties.Name="Background opacity" />
        <TextBlock Style="{StaticResource LabelStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="0% is fully see-through, 100% is solid. The default is 30%." />
        <CheckBox x:Name="BlurCheck" Content="Blur what is behind the widget (frosted glass)" Margin="0,0,0,6"
                  Click="BlurCheck_Click" />
        <CheckBox x:Name="TopmostCheck" Content="Keep the widget always on top" Margin="0,0,0,16"
                  Click="TopmostCheck_Click" />

        <TextBlock Text="Windows" Style="{StaticResource HeadingStyle}" />
        <CheckBox x:Name="StartupCheck" Content="Start with Windows" Margin="0,0,0,6" Click="StartupCheck_Click" />
        <CheckBox x:Name="WidgetOnlyCheck" Content="At sign-in, open only the widget" Margin="20,0,0,6"
                  Click="WidgetOnlyCheck_Click" />
        <TextBlock x:Name="StartupNote" Style="{StaticResource LabelStyle}" TextWrapping="Wrap" />

        <Button Content="Close" HorizontalAlignment="Right" Padding="22,6" Margin="0,18,0,0"
                IsDefault="True" IsCancel="True" />
    </StackPanel>
</Window>
